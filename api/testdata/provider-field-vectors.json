{
  "_doc": "Shared vectors for the provider field-descriptor validator (feature 033, contracts/deployer-config-ui.md §2-§4a). Run by the Go validator (internal/provider/schema_test.go) and by the UI fieldsToZod/overrideToZod tests, so client and server cannot drift. mode: configuration | effective (ValidateInput) or override (ValidateOverride: config is the stored configuration, override the target override). errors: exact map of field path -> code; target_supplied: keys returned in configuration mode.",
  "providers": {
    "zone": {
      "type": "vec_zone",
      "display_name": "Zone",
      "config_fields": [
        {"key": "zone_id", "label": "Zone ID", "type": "string", "required": true, "overridable": true, "group": "connection", "pattern": "^[a-f0-9]{32}$"},
        {"key": "region", "label": "Region", "type": "string", "required": true, "group": "connection", "max_length": 20},
        {"key": "note", "label": "Note", "type": "text", "group": "options", "max_length": 10},
        {"key": "endpoint_url", "label": "URL", "type": "url", "group": "connection"},
        {"key": "timeout_seconds", "label": "Timeout", "type": "int", "group": "options", "min": 1, "max": 300, "default": 60, "overridable": true},
        {"key": "verify", "label": "Verify", "type": "bool", "group": "options", "default": true},
        {"key": "mode", "label": "Mode", "type": "enum", "group": "options", "options": [{"value": "a", "label": "A"}, {"value": "b", "label": "B"}], "overridable": true},
        {"key": "tags", "label": "Tags", "type": "string_list", "group": "options", "max_items": 2, "pattern": "^[a-z]+$", "overridable": true},
        {"key": "headers", "label": "Headers", "type": "key_value", "group": "options", "max_items": 2},
        {"key": "metadata", "label": "Metadata", "type": "key_value", "group": "options", "max_items": 2, "overridable": true}
      ],
      "credential_fields": [
        {"key": "user", "label": "User", "type": "string", "required": true, "group": "credentials", "max_length": 8},
        {"key": "token", "label": "Token", "type": "string", "secret": true, "required": true, "group": "credentials", "max_length": 16},
        {"key": "extra", "label": "Extra", "type": "text", "secret": true, "group": "credentials"}
      ]
    },
    "hosts": {
      "type": "vec_hosts",
      "display_name": "Hosts",
      "config_fields": [
        {"key": "host_ids", "label": "Hosts", "type": "host_selector", "group": "connection", "max_items": 3, "overridable": true},
        {"key": "host_tags", "label": "Host tags", "type": "string_list", "group": "connection", "max_items": 2, "overridable": true, "pattern": "^[A-Za-z0-9_.:/-]{1,63}(=[^\\x00-\\x1f]{0,255})?$"},
        {"key": "cert_name", "label": "Certificate name", "type": "string", "group": "options", "overridable": true, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"}
      ],
      "credential_fields": [],
      "one_of_required": [["host_ids", "host_tags"]]
    },
    "mixed_group": {
      "type": "vec_mixed",
      "display_name": "Mixed group",
      "config_fields": [
        {"key": "a", "label": "A", "type": "string", "group": "options", "overridable": true},
        {"key": "b", "label": "B", "type": "string", "group": "options"}
      ],
      "credential_fields": [],
      "one_of_required": [["a", "b"]]
    }
  },
  "cases": [
    {"name": "complete configuration", "provider": "zone", "mode": "configuration",
     "config": {"zone_id": "023e105f4ecef8ad9ca31a8372d0c353", "region": "eu"}, "credentials": {"user": "u", "token": "t0k"},
     "errors": {}, "target_supplied": []},
    {"name": "overridable required left to targets", "provider": "zone", "mode": "configuration",
     "config": {"region": "eu"}, "credentials": {"user": "u", "token": "t0k"},
     "errors": {}, "target_supplied": ["zone_id"]},
    {"name": "overridable required empty string left to targets", "provider": "zone", "mode": "configuration",
     "config": {"region": "eu", "zone_id": ""}, "credentials": {"user": "u", "token": "t0k"},
     "errors": {}, "target_supplied": ["zone_id"]},
    {"name": "effective mode needs the overridable field", "provider": "zone", "mode": "effective",
     "config": {"region": "eu"}, "credentials": {"user": "u", "token": "t0k"},
     "errors": {"config.zone_id": "required"}, "target_supplied": []},
    {"name": "missing non-overridable config and credentials", "provider": "zone", "mode": "configuration",
     "config": {"zone_id": "023e105f4ecef8ad9ca31a8372d0c353"}, "credentials": {"token": ""},
     "errors": {"config.region": "required", "credentials.user": "required", "credentials.token": "required"}, "target_supplied": []},
    {"name": "pattern, wrong type, length", "provider": "zone", "mode": "configuration",
     "config": {"zone_id": "NOT-HEX", "region": 5, "note": "01234567890"}, "credentials": {"user": "toolongusername", "token": "t"},
     "errors": {"config.zone_id": "pattern", "config.region": "wrong_type", "config.note": "too_long:10", "credentials.user": "too_long:8"}, "target_supplied": []},
    {"name": "int bounds and fraction", "provider": "zone", "mode": "configuration",
     "config": {"zone_id": "023e105f4ecef8ad9ca31a8372d0c353", "region": "eu", "timeout_seconds": 301}, "credentials": {"user": "u", "token": "t"},
     "errors": {"config.timeout_seconds": "out_of_range:1..300"}, "target_supplied": []},
    {"name": "int must be integral", "provider": "zone", "mode": "configuration",
     "config": {"zone_id": "023e105f4ecef8ad9ca31a8372d0c353", "region": "eu", "timeout_seconds": 1.5}, "credentials": {"user": "u", "token": "t"},
     "errors": {"config.timeout_seconds": "wrong_type"}, "target_supplied": []},
    {"name": "bool, enum, url", "provider": "zone", "mode": "configuration",
     "config": {"zone_id": "023e105f4ecef8ad9ca31a8372d0c353", "region": "eu", "verify": "true", "mode": "c", "endpoint_url": "ftp://x.example"}, "credentials": {"user": "u", "token": "t"},
     "errors": {"config.verify": "wrong_type", "config.mode": "not_in_options", "config.endpoint_url": "invalid_url"}, "target_supplied": []},
    {"name": "url with user info", "provider": "zone", "mode": "configuration",
     "config": {"zone_id": "023e105f4ecef8ad9ca31a8372d0c353", "region": "eu", "endpoint_url": "https://user:pw@hook.example/x"}, "credentials": {"user": "u", "token": "t"},
     "errors": {"config.endpoint_url": "invalid_url"}, "target_supplied": []},
    {"name": "lists and maps", "provider": "zone", "mode": "configuration",
     "config": {"zone_id": "023e105f4ecef8ad9ca31a8372d0c353", "region": "eu", "tags": ["a", "b", "c"], "metadata": {"a": "1", "b": "2", "c": "3"}}, "credentials": {"user": "u", "token": "t"},
     "errors": {"config.tags": "too_many_items:2", "config.metadata": "too_many_items:2"}, "target_supplied": []},
    {"name": "list item pattern", "provider": "zone", "mode": "configuration",
     "config": {"zone_id": "023e105f4ecef8ad9ca31a8372d0c353", "region": "eu", "tags": ["ok", "NOT OK"]}, "credentials": {"user": "u", "token": "t"},
     "errors": {"config.tags": "pattern"}, "target_supplied": []},
    {"name": "forbidden header", "provider": "zone", "mode": "configuration",
     "config": {"zone_id": "023e105f4ecef8ad9ca31a8372d0c353", "region": "eu", "headers": {"Authorization": "Bearer x"}}, "credentials": {"user": "u", "token": "t"},
     "errors": {"config.headers": "forbidden_header:Authorization"}, "target_supplied": []},
    {"name": "unknown keys refused (incl. the credential-redirect settings)", "provider": "zone", "mode": "configuration",
     "config": {"zone_id": "023e105f4ecef8ad9ca31a8372d0c353", "region": "eu", "endpoint": "https://evil.example", "api_base": "https://evil.example"}, "credentials": {"user": "u", "token": "t", "password": "p"},
     "errors": {"config.endpoint": "unknown_field", "config.api_base": "unknown_field", "credentials.password": "unknown_field"}, "target_supplied": []},
    {"name": "one-of group satisfied", "provider": "hosts", "mode": "configuration",
     "config": {"host_tags": ["role=web"]}, "credentials": {}, "errors": {}, "target_supplied": []},
    {"name": "one-of group fully overridable left to targets", "provider": "hosts", "mode": "configuration",
     "config": {"cert_name": "www"}, "credentials": {}, "errors": {}, "target_supplied": ["host_ids", "host_tags"]},
    {"name": "one-of group empty in effective mode", "provider": "hosts", "mode": "effective",
     "config": {"host_ids": [], "host_tags": []}, "credentials": {},
     "errors": {"config.host_ids": "one_of_required:host_ids,host_tags", "config.host_tags": "one_of_required:host_ids,host_tags"}, "target_supplied": []},
    {"name": "one-of group with a non-overridable member", "provider": "mixed_group", "mode": "configuration",
     "config": {}, "credentials": {},
     "errors": {"config.a": "one_of_required:a,b", "config.b": "one_of_required:a,b"}, "target_supplied": []},
    {"name": "host tag pattern", "provider": "hosts", "mode": "configuration",
     "config": {"host_tags": ["=x"]}, "credentials": {}, "errors": {"config.host_tags": "pattern"}, "target_supplied": []},
    {"name": "override supplies the target-supplied field", "provider": "zone", "mode": "override",
     "config": {"region": "eu"}, "override": {"zone_id": "023e105f4ecef8ad9ca31a8372d0c353"}, "errors": {}},
    {"name": "override missing the target-supplied field", "provider": "zone", "mode": "override",
     "config": {"region": "eu"}, "override": {}, "errors": {"config_overrides.zone_id": "required"}},
    {"name": "override with an empty value inherits", "provider": "zone", "mode": "override",
     "config": {"region": "eu", "zone_id": "023e105f4ecef8ad9ca31a8372d0c353"}, "override": {"zone_id": ""}, "errors": {}},
    {"name": "override of a non-overridable, credential or unknown key", "provider": "zone", "mode": "override",
     "config": {"region": "eu", "zone_id": "023e105f4ecef8ad9ca31a8372d0c353"}, "override": {"region": "us", "token": "x", "endpoint": "https://evil.example"},
     "errors": {"config_overrides.region": "not_overridable", "config_overrides.token": "not_overridable", "config_overrides.endpoint": "unknown_field"}},
    {"name": "override value violating its rule", "provider": "zone", "mode": "override",
     "config": {"region": "eu"}, "override": {"zone_id": "nothex", "timeout_seconds": 0},
     "errors": {"config_overrides.zone_id": "pattern", "config_overrides.timeout_seconds": "out_of_range:1..300"}},
    {"name": "override must complete a one-of group", "provider": "hosts", "mode": "override",
     "config": {}, "override": {"cert_name": "www"},
     "errors": {"config_overrides.host_ids": "one_of_required:host_ids,host_tags", "config_overrides.host_tags": "one_of_required:host_ids,host_tags"}},
    {"name": "override completes a one-of group", "provider": "hosts", "mode": "override",
     "config": {}, "override": {"host_ids": ["0192a7c0-0000-7000-8000-000000000001"]}, "errors": {}}
  ]
}
